# Copy this file to terraform.tfvars and replace the values below.

location                     = "eastus"
resource_group_name          = "rg-aks-prod"
cluster_name                 = "aks-prod"
environment                  = "prod"
owner                        = "platform"
subscription_id              = ""
ssh_public_key               = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQDBX...example"
private_cluster_enabled       = false
authorized_ip_ranges         = ["203.0.113.10/32"]
kubernetes_version           = "1.29.7"
dns_prefix                   = "aks-prod"

# Networking
vnet_address_space           = ["10.10.0.0/16"]
subnet_address_prefixes      = ["10.10.1.0/24"]

# Node pools
system_node_pool_name        = "system"
system_node_count            = 2
system_node_vm_size          = "Standard_DS2_v2"
user_node_pool_name          = "user"
user_node_count              = 2
user_node_vm_size            = "Standard_DS3_v2"
node_min_count               = 1
node_max_count               = 5
enable_user_pool_autoscaling = true
node_os_disk_size_gb         = 128

# Tags
# tags = {
#   "CostCenter" = "12345"
#   "Application" = "platform"
# }
